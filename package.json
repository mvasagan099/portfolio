  "version": "1.0.0",
  "private": true,
  "description": "Manivasagan A. — Software Developer Portfolio",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-server.mjs",
    "start": "node scripts/serve.mjs",
